{
  "name": "suthep",
  "version": "1.0.0",
  "type": "module",
  "description": "CLI tool for deploying projects with automatic Nginx reverse proxy and HTTPS setup",
  "main": "dist/index.js",
  "bin": {
    "suthep": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "deploy",
    "nginx",
    "certbot",
    "docker",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.2",
    "inquirer": "^13.0.2",
    "js-yaml": "^4.1.1",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
